# Dependencies — restored with `npm install` from package-lock.json
node_modules/
.pnp
.pnp.js

# Build output — regenerated with `npm run build`
dist/
dist-ssr/
build/

# Vite / Vitest caches
.vite/
node_modules/.vite/
.cache/
*.tsbuildinfo

# Test coverage
coverage/
*.lcov

# Environment and secrets — never commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Claude Code local settings (personal permissions, not shared)
.claude/settings.local.json

# OS / OneDrive cruft — this project lives in a OneDrive folder
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*~

# Committed on purpose, listed here so nobody adds them by mistake:
#   .agents/          — vendored skills; teammates need these on clone
#   skills-lock.json  — pins each skill's source and hash
#   public/           — source images the build copies into dist/
#   docs/             — branding and layout reference
